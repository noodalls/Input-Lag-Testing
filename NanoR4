void calculate_averages(){//can redo this with log now
OPT1_count=0;OPT1_sum=0;OPT1_avg=0.0;
OPT2_count=0;OPT2_sum=0;OPT2_avg=0.0;
P1_wins_count = 0;P2_wins_count = 0;P1_P2_draw_count = 0;
top_value = 0.0;bottom_value = 0.0;screen_draw_time = 0.0;
p1_wins_count = 0;
p2_wins_count = 0;
p1_p2_draw_count = 0;
// int upper = 25;
// int lower = 75;

for (int i = 0;i<1000;i++){
  if ((OPT1_log[i]!=0) && (OPT2_log[i]!=0)){
  if (OPT1_log[i] != 0){OPT1_count++;OPT1_sum=OPT1_sum+OPT1_log[i];}
  if (OPT2_log[i] != 0){OPT2_count++;OPT2_sum=OPT2_sum+OPT2_log[i];}
  if ((OPT2_log[i]-OPT1_log[i]) > OVER_UNDER){P1_wins_count++;}
  if ((OPT1_log[i]-OPT2_log[i]) > OVER_UNDER){P2_wins_count++;}
  if (((OPT2_log[i]-OPT1_log[i]) < OVER_UNDER) && ((OPT1_log[i]-OPT2_log[i]) < OVER_UNDER)){P1_P2_draw_count++;}
  if (OPT1_log[i]<OPT2_log[i]){p1_wins_count++;}
  if (OPT1_log[i]>OPT2_log[i]){p2_wins_count++;}
  if (OPT1_log[i]==OPT2_log[i]){p1_p2_draw_count++;}
}}

if (OPT1_count !=0){OPT1_avg=OPT1_sum/OPT1_count;}
if (OPT2_count !=0){OPT2_avg=OPT2_sum/OPT2_count;}

if ((OPT1_avg != OPT2_avg)&&(OPT1_avg!=0) && (OPT2_avg!=0)){
  screen_draw_time = (100*(OPT2_avg-OPT1_avg)/(lower-upper));
  top_value = OPT1_avg - (screen_draw_time*upper/100);
  bottom_value = top_value + screen_draw_time;
}
}

