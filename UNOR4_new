void clear_frame(){
for (int i=0;i<8;i++){
  for (int j=0;j<12;j++){
    frame[i][j]=0;
  }}}

void number_to_led(int _number, int _row){
  if (_number < 129 && _row <7){
    for (int i=0;i<int(_number/10);i++){
    frame[_row][i]=1;}
    for(int i=0;i < int (_number%10);i++){
    frame[_row+1][i]=1;}}}












void loop() {
