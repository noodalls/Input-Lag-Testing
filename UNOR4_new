void EEPROM_UPDATE_PAIR(int _location,int _value){
EEPROM.update(_location,_value/100);
EEPROM.update(_location+1,_value%100);
}

int EEPROM_READ_PAIR(int _location){
int result = 100*EEPROM.read(_location) + EEPROM.read(_location+1);
return result;
}







