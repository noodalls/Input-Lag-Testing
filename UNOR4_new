  }}}

void number_to_led(int _number, int _row){
  if (_number < 129 && _row <7){
    for (int i=0;i<int(_number/10);i++){
    frame[_row][i]=1;}
    for(int i=0;i < int (_number%10);i++){
    frame[_row+1][i]=1;}}}


void hundreds_to_led(int _number,int _row){
for (int i =0;i<int(_number/100);i++){frame[_row][i]=1;}
for (int i =0;i<int((_number/10)%10);i++){frame[_row+1][i]=1;}
for (int i =0;i<int(_number%10);i++){frame[_row+2][i]=1;}
}







