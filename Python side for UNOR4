def click_event_mode4(event, x, y, flags, param):
    global read_time
    global RETURN_TIME
    global loop_number
    global LOOP_MAX
    global expect_time
    global END_TIME
    global current_x

    current_x = x
    if event == cv2.EVENT_LBUTTONDOWN and (current_x < RETURN_TIME) and y<128:
        arduino.write(bytes('r'+str(current_x), 'utf-8'))
        time.sleep(0.25)
        calculate_min_max(loop_number)


    if event == cv2.EVENT_RBUTTONDOWN and (current_x > read_time) and y < 128:
        arduino.write(bytes('R'+str(current_x), 'utf-8'))
        time.sleep(0.10)
        calculate_min_max(loop_number)

    if event == cv2.EVENT_MBUTTONDOWN and (current_x > read_time) and y < 128:
        expect_time = x
        calculate_min_max(loop_number)

    if event == 10 and flags < 0 and x<250:  # mouse wheel
        arduino.write(bytes('l'+str(max(loop_number-1,0)), 'utf-8'))
        time.sleep(0.10)

    if event == 10 and flags > 0 and x<250:  # mouse wheel
        arduino.write(bytes('l'+str(min(LOOP_MAX,loop_number+1)), 'utf-8'))
        time.sleep(0.01)

    if event == 10 and flags < 0 and x>250 and x<500:  # mouse wheel
        arduino.write(bytes('L'+str(max(LOOP_MAX-1,0)), 'utf-8'))
        time.sleep(0.25)

    if event == 10 and flags > 0 and x>250 and x<500:  # mouse wheel
        arduino.write(bytes('L'+str(LOOP_MAX+1), 'utf-8'))
        time.sleep(0.10)


