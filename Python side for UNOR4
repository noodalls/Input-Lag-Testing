def show_screen(_screen_title,_screen,_click_event,):
    global k

    cv2.namedWindow(_screen_title, cv2.WINDOW_NORMAL)
    cv2.setWindowProperty(_screen_title, cv2.WND_PROP_FULLSCREEN, cv2.WINDOW_FULLSCREEN)
    cv2.setWindowProperty(_screen_title, cv2.WND_PROP_TOPMOST, 1)
    cv2.moveWindow(_screen_title,screen_x_position,screen_y_position)# use this line for 3 monitor setup
    cv2.imshow(_screen_title, _screen)
    cv2.setMouseCallback(_screen_title, _click_event)
    k = cv2.waitKey(33)


def click_event_mode4(event, x, y, flags, param):
    global read_time
    global RETURN_TIME
    global loop_number
    global LOOP_MAX
    global expect_time
    global END_TIME
    global current_x

    current_x = x
    if event == cv2.EVENT_LBUTTONDOWN and (current_x < RETURN_TIME) and y<128:
        arduino.write(bytes('r'+str(current_x), 'utf-8'))
        time.sleep(0.25)
        calculate_averages()


    if event == cv2.EVENT_RBUTTONDOWN and (current_x > read_time) and y < 128:
        arduino.write(bytes('R'+str(current_x), 'utf-8'))
        time.sleep(0.10)
        calculate_averages()

    if event == cv2.EVENT_MBUTTONDOWN and (current_x > read_time) and y < 128:
        expect_time = x
        calculate_averages()

    if event == 10 and flags < 0 and x<250:  # mouse wheel
        arduino.write(bytes('l'+str(max(loop_number-1,0)), 'utf-8'))
        time.sleep(0.10)

    if event == 10 and flags > 0 and x<250:  # mouse wheel
        arduino.write(bytes('l'+str(min(LOOP_MAX,loop_number+1)), 'utf-8'))
        time.sleep(0.01)

    if event == 10 and flags < 0 and x>250 and x<500:  # mouse wheel
        arduino.write(bytes('L'+str(max(LOOP_MAX-1,0)), 'utf-8'))
        time.sleep(0.25)

    if event == 10 and flags > 0 and x>250 and x<500:  # mouse wheel
        arduino.write(bytes('L'+str(LOOP_MAX+1), 'utf-8'))
        time.sleep(0.10)


def generic_keys():
    global k
    global current_value
    global screen_x_position
    global screen_y_position
    global mode

    if (k != -1):
        print(k)
    if k == 27:#esc key
        mode = 10
    if k == 65:#A key
        ()
    if k == 97:#a key
        ()

    if k == 112:#p key
        arduino.write(bytes('p', 'utf-8'))
        time.sleep(0.10)
    if k == 80:#P key
        arduino.write(bytes('P', 'utf-8'))
        time.sleep(0.10)

    if k == 109:#m key
        arduino.write(bytes('m'+str(current_value), 'utf-8'))
        time.sleep(0.10)
        current_value = 0
    if k == 77:#M key
        arduino.write(bytes('M' + str(current_value), 'utf-8'))
        time.sleep(0.10)
        current_value = 0

    if k == 108:#l key
        if current_value < LOOP_MAX:
            arduino.write(bytes('l' + str(current_value), 'utf-8'))
            time.sleep(0.10)
        current_value = 0
    if k == 76:#L key
        arduino.write(bytes('L' + str(current_value), 'utf-8'))
        time.sleep(0.10)
        current_value = 0

    if k == 114:#r key
        if current_value < RETURN_TIME:
            arduino.write(bytes('r' + str(current_value), 'utf-8'))
            time.sleep(0.10)
        current_value = 0

    if k == 82:#R key
        if current_value > read_time:
            arduino.write(bytes('R' + str(current_value), 'utf-8'))
            time.sleep(0.10)
        current_value = 0

    if k == 101:#e key
        arduino.write(bytes('e' + str(current_value), 'utf-8'))
        time.sleep(0.10)
        current_value = 0

    if k == 69:#E key
        arduino.write(bytes('E' + str(current_value), 'utf-8'))
        time.sleep(0.10)
        current_value = 0

    if k == 43:#+ key
        arduino.write(bytes('+' + str(current_value), 'utf-8'))
    if k == 45:#- key
        arduino.write(bytes('-' + str(current_value), 'utf-8'))
    if k == 61:#= key
        arduino.write(bytes('=' + str(current_value), 'utf-8'))
    if (k == 48):
        current_value = abs(current_value * 10) + 0
    elif (k == 49):
        current_value = abs(current_value * 10) + 1
    elif (k == 50):
        current_value = abs(current_value * 10) + 2
    elif (k == 51):
        current_value = abs(current_value * 10) + 3
    elif (k == 52):
        current_value = abs(current_value * 10) + 4
    elif (k == 53):
        current_value = abs(current_value * 10) + 5
    elif (k == 54):
        current_value = abs(current_value * 10) + 6
    elif (k == 55):
        current_value = abs(current_value * 10) + 7
    elif (k == 56):
        current_value = abs(current_value * 10) + 8
    elif (k == 57):
        current_value = abs(current_value * 10) + 9
    elif (k == 8):  # bksp
        current_value = current_value / 10
        current_value = int(current_value)

    if k == 113:#q key
        screen_x_position = screen_x_position - 480
    if k == 81:#Q key
        screen_y_position=screen_y_position - 270
    if k == 119:#w key
        screen_x_position = screen_x_position + 480
    if k == 87:  # W key
        screen_y_position = screen_y_position + 270


