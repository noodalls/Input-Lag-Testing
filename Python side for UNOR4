def calculate_min_max(_loop_number):
    global PT1_value
    global PT1_min
    global PT1_max
    global PT1_time

    global PT2_value
    global PT2_min
    global PT2_max
    global PT2_time

    PT1_min[_loop_number] = 128
    PT1_max[_loop_number] = 0
    PT1_value[_loop_number] = 0
    PT1_time[_loop_number] = 0

    PT2_min[_loop_number] = 128
    PT2_max[_loop_number] = 0
    PT2_value[_loop_number] = 0
    PT2_time[_loop_number] = 0

    v = range(0, read_time, 1)
    for p in v:
        if PT1_max[_loop_number] < PT1[_loop_number * 1000 + p]:
            PT1_max[_loop_number] = PT1[_loop_number * 1000 + p]
        if PT1_min[_loop_number] > PT1[_loop_number * 1000 + p]:
            PT1_min[_loop_number] = PT1[_loop_number * 1000 + p]
        if PT2_max[_loop_number] < PT2[_loop_number * 1000 + p]:
            PT2_max[_loop_number] = PT2[_loop_number * 1000 + p]
        if PT2_min[_loop_number] > PT2[_loop_number * 1000 + p]:
            PT2_min[_loop_number] = PT2[_loop_number * 1000 + p]

    v = range(expect_time, RETURN_TIME, 1)
    for p in v:
        if (PT1_value[_loop_number] == 0) and (greater_than == 1) and (PT1[_loop_number * 1000 + p] > PT1_max[_loop_number] + margin):
            PT1_time[_loop_number] = p - read_time
            PT1_value[_loop_number] = PT1[_loop_number * 1000 + p]
        if (PT1_value[_loop_number] == 0) and (less_than == 1) and (PT1[_loop_number * 1000 + p] < PT1_min[_loop_number] - margin):
            PT1_time[_loop_number] = p - read_time
            PT1_value[_loop_number] = PT1[_loop_number * 1000 + p]
        if both_OPT == 1:
            if (PT2_value[_loop_number] == 0) and (greater_than == 1) and (PT2[_loop_number * 1000 + p] > PT2_max[_loop_number] + margin):
                PT2_time[_loop_number] = p - read_time
                PT2_value[_loop_number] = PT2[_loop_number * 1000 + p]
            if (PT2_value[_loop_number] == 0) and (less_than == 1) and (PT2[_loop_number * 1000 + p] < PT2_min[_loop_number] - margin):
                PT2_time[_loop_number] = p - read_time
                PT2_value[_loop_number] = PT2[_loop_number * 1000 + p]


def calculate_min_max_all():
    for p in range(LOOP_MAX):
        calculate_min_max(p)


def calculate_averages():
    global results_summary
    global PT1_avg
    global PT2_avg

    PT1_avg = 0.0
    PT1_sum = 0
    PT1_denom =0
    for p in range(1000):
        if PT1_use[p] == 1:
            PT1_sum = PT1_sum + PT1_time[p]
            PT1_denom = PT1_denom + 1
    PT1_avg = round(PT1_sum / PT1_denom, 2)

    PT2_avg = 0.0
    PT2_sum = 0
    PT2_denom = 0
    for p in range(1000):
        if PT2_use[p] == 1:
            PT2_sum = PT2_sum + PT2_time[p]
            PT2_denom = PT2_denom + 1
    PT2_avg = round(PT2_sum / PT1_denom, 2)
    results_summary[6] = PT1_avg
    results_summary[7] = PT2_avg


def obtain_data(_data):
    global data
    global loop_number
    global LOOP_MAX
    global read_time
    global RETURN_TIME
    global both_OPT
    global margin
    global MARGIN
    global expect_time
    global END_TIME
    global greater_than
    global less_than
    global PT1
    global PT2

    _data = str(_data)
    _data = _data.replace("b'", "")
    _data = _data.replace("'", "")
    _data = _data.replace("\\r", "").replace("\\n", "")

    if _data != "":

        print(str(_data))

        if _data[0] == 'l':
            loop_number = int(_data[1:])

        if _data[0] == 'L':
            LOOP_MAX = int(_data[1:])


        if _data[0] == 'r':
            read_time = int(_data[1:])


        if _data[0] == 'R':
            RETURN_TIME = int(_data[1:])


        if _data[0] == 'P':
            both_OPT = 1

        if _data[0] == 'p':
            both_OPT = 0

        if _data[0] == 'm':
            margin = int(_data[1:])


        if _data[0] == 'M':
            MARGIN = int(_data[1:])


        if _data[0] == 'e':
            expect_time = int(_data[1:])


        if _data[0] == 'E':
            END_TIME = int(_data[1:])


        if _data[0] == '+':
            greater_than = 1
            less_than = 0

        if _data[0] == '-':
            greater_than = 0
            less_than = 1

        if _data[0] == '=':
            greater_than = 1
            less_than = 1


        if _data[0] == 'u':
            _data = _data[1:]
            data_array = _data.split(",")
            data_array.pop()  # include this otherwise last comma causes empty 501 entry
            v = range(0, len(data_array), 1)
            for p in v:
                PT1[loop_number * 1000 + p] = data_array[p]

            PT1_use[loop_number]=1
            calculate_min_max(loop_number)
            calculate_averages()

        if _data[0] == 'v':
            _data = _data[1:]
            data_array = _data.split(",")
            data_array.pop()  # include this otherwise last comma causes empty 501 entry
            v = range(0, len(data_array), 1)
            for p in v:
                PT2[loop_number * 1000 + p] = data_array[p]
            PT2_use[loop_number]=1
            calculate_min_max(loop_number)
            calculate_averages()

